        .frame(maxWidth: .infinity)
        .padding(.vertical, 8)
        .background(newTrackType == type ? type.color.opacity(0.15) : Color.gray.opacity(0.05))
        .overlay(
            RoundedRectangle(cornerRadius: 6)
                .stroke(newTrackType == type ? type.color : Color.clear, lineWidth: 2)
        )
        .cornerRadius(6)
    }
    
    @ViewBuilder

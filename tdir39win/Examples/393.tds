Aspect: red
	IconE: NN_r_E.xpm
	IconW: NN_r_W.xpm
	IconN: NN_r_N.xpm
	IconS: NN_r_S.xpm
	Action: stop

Aspect: green
	IconE: NN_g_E.xpm
	IconW: NN_g_W.xpm
	IconN: NN_g_N.xpm
	IconS: NN_g_S.xpm
	Action: proceed
	
OnUncleared:
	if .trainApproachingDistance < 0:
		return
	end
	if .trainApproachingDistance < 200:
		.aspect = green
	else
		.aspect = red
	end
end
